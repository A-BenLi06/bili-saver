# 可选：本地构建 teriteri-client 前端镜像（默认 compose 会使用它；不需要可删掉该 service）
FROM node:16-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
RUN git clone --depth 1 https://github.com/xunlu129/teriteri-client.git .
RUN npm config set registry https://registry.npmmirror.com && npm install && npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
